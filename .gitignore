# Рабочее состояние: записи экрана, ролики, замечания, озвучка, голоса, токен сервера.
# Никогда не коммитить: здесь записи чужих интерфейсов и голоса живых людей, а из
# истории git такое не вычищается — коммиты остаются после удаления файлов.
studio/journal/
studio/venv-*/
out/
public/clips/
public/timeline/

# Настройки конкретной установки: адреса стендов и учётные данные.
studio/takt.json
studio/takt.preset.json

# Разборы Lavish: рабочая переписка с человеком, а не исходник. Живут в дереве
# скилла, поэтому любая незаконченная правка делала его грязным — и takt update
# отказывался работать, хотя обновлять было нечего. Готовый разбор при нужде
# выгружается командой lavish-axi export.
.lavish/

node_modules/
.DS_Store
*.log

# Пресет конкретной системы: сцены, селекторы её интерфейса, готовые схемы.
# Живёт во внутренней обвязке, а не в общем репозитории.
fesb-preset/

# Скриншоты и кадры с интерфейсом снимаемой системы.
studio/shot-*.png
studio/frame.jpg
exports/
__pycache__/
